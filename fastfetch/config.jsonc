{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 18
    }
  },
  "modules": [
    // Title
    {
      "type": "title",
      "format": "{#1}╭───────────────────────────{#}{#1}{#title} Arch BTW {#}{#1}───────────────────────────╮"
    },
    // System
    {
      "type": "custom",
      "format": "{#1}│ {#}System"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}󰍹 OS"
    },
    {
      "type": "host",
      "key": "{#separator}│  {#keys}󰌢 Host",
      "format": "{family}"
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏖 Packages"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    // Desktop
    {
      "type": "custom",
      "format": "{#1}│ {#}Desktop"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys}󱂬 WM"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "terminal",
      "key": "{#separator}│  {#keys}󰆍 Terminal"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    // Hardware
    {
      "type": "custom",
      "format": "{#1}│ {#}Hardware"
    },
    {
      "type": "cpu",
      "key": "{#separator}│  {#keys}󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "{#separator}│  {#keys}󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊 Disk (/)",
      "folders": "/"
    },
    // TLP naming: BAT0 = internal, BAT1 = external
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰁹 Internal",
      "text": "b=/sys/class/power_supply/BAT0; [ -d $b ] && echo \"$(cat $b/capacity)% [$(cat $b/status)]\" || echo 'Not present'"
    },
    {
      "type": "command",
      "key": "{#separator}│  {#keys}󰁹 External",
      "text": "b=/sys/class/power_supply/BAT1; [ -d $b ] && echo \"$(cat $b/capacity)% [$(cat $b/status)]\" || echo 'Not present'"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },
    // Colors
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },
    // Footer
    {
      "type": "custom",
      "format": "{#1}╰────────────────────────────────────────────────────────────────╯"
    }
  ]
}
